# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ORGANISATION_STARTER_PRICE_ID=
STRIPE_ORGANISATION_GROWTH_PRICE_ID=
STRIPE_ORGANISATION_SCALE_PRICE_ID=
STRIPE_CLIENT_SUBSCRIPTION_PRICE_ID=
STRIPE_KINGLANCER_SUBSCRIPTION_PRICE_ID=

# App URLs
APP_ENV=
NEXT_PUBLIC_APP_URL=
APP_URL=

# Scheduled jobs
CRON_SECRET=

# Email
# Set ENABLE_EMAIL=true to send real emails (always true in production)
ENABLE_EMAIL=
BREVO_API_KEY=
BREVO_SENDER_NAME=KingsHire
BREVO_SENDER_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

# PostHog
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Espees (ESP) payment rail — inbound escrow funding. Leave ESPEES_API_KEY /
# ESPEES_MERCHANT_WALLET unset to hide the Espees payment option entirely.
ESPEES_API_KEY=
ESPEES_MERCHANT_WALLET=
# Optional overrides (sensible defaults in code):
# ESPEES_API_BASE=https://api.espees.org
# ESPEES_PAY_BASE=https://payment.espees.org
# ESP_USD_RATE=1.60          # USD per 1 ESP (Espees peg)
# ESPEES_FX_BUFFER=0.02       # FX safety buffer on GBP→ESP (2%)
# GBP_USD_FALLBACK=1.25       # used only if the live GBP→USD source is down

# Admin dashboard
ADMIN_PASSCODE=
ADMIN_SESSION_SECRET=
