# Supabase staging project
NEXT_PUBLIC_SUPABASE_URL=https://<staging-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<staging-publishable-key>
SUPABASE_SECRET_KEY=<staging-service-role-key>

# Stripe test mode
STRIPE_SECRET_KEY=sk_test_<...>
STRIPE_WEBHOOK_SECRET=whsec_<staging-webhook-secret>

# Railway staging app URL
APP_ENV=staging
NEXT_PUBLIC_APP_URL=https://<staging-app>.up.railway.app
APP_URL=https://<staging-app>.up.railway.app

# Scheduled jobs
CRON_SECRET=<strong-random-staging-secret>

# Email
BREVO_API_KEY=<staging-or-production-brevo-key>
BREVO_SENDER_NAME=KingsHire
BREVO_SENDER_EMAIL=kingshirecompany@gmail.com
ADMIN_NOTIFICATION_EMAIL=kingshirecompany@gmail.com

# Admin dashboard
ADMIN_EMAILS=kingshirecompany@gmail.com
ADMIN_PASSCODE=<strong-shared-admin-passcode>
ADMIN_SESSION_SECRET=<strong-random-staging-secret>
